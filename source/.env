# Copy this file to ".env" (same folder as dashboard.py) and fill in your key.
# Never commit your real .env file to version control.

# Required: your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY= API_KEY_GOES_HERE
# Optional: override the default model without touching any code.
# Any current Groq-supported chat model id works here.
GROQ_MODEL=llama-3.3-70b-versatile
